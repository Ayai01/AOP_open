s=1\n.meas ac test_gm find par('-vdb(vo)') when vp(vo)=-180 cross=1\n.endif\n.if (sim_type==1)\nVDD vdd 0 DC 1.8 AC 1\nVIP vip 0 DC 0.9\nVFB vin vo 0\nCLOAD vo 0 1e-12\n.dc VDD 1.8 1.8 .01\n.meas dc test_iq find par('-i(VDD)') at=1.8\n.meas dc test_power find par('-i(VDD)*1.8') at=1.8\n.ac lin 1 1000 1000\n.meas ac test_psrr find par('-vdb(vo)') at=1000\n.endif\n.if (sim_type==2)\nVDD vdd 0 DC 1.8\nVFB vin vo 0\nCLOAD vo 0 1e-12\nVIP vip 0 PULSE(1.4 0.4 1n 1p 1p 10u 20u)\n.tran 10n 19.5u\n.meas tran test_rise trig v(vo) val=0.7 rise=1 targ v(vo) val=1.1 rise=1 from=10u to=19u\n.meas tran test_fall trig v(vo) val=1.1 fall=1 targ v(vo) val=0.7 fall=1 from=0u to=9u\n.meas tran test_sr_p param='0.4/test_rise'\n.meas tran test_sr_n param='0.4/test_fall'\n.endif\n.if (sim_type==3)\nVDD vdd 0 DC 1.8\nVFB vin vo 0\nCLOAD vo 0 1e-12\nVIP vip 0 PULSE(0.9 0.91 2u 20n 20n 8u 16u)\n.tran 10n 12u\n.meas tran test_step_error max par('abs(v(vo)-v(vip))') from=7u to=9u\n.endif\n.if (sim_type==4)\nVDD vdd 0 DC 1.8\nVIN vin 0 0.9\nVIP vip 0 0.9\n.dc VIP 0.8 1 0.2\nVCMLOAD load_reference 0 0.9\nRLOAD vo load_reference 1000\n.meas dc test_vol find v(vo) at=0.8\n.meas dc test_voh_headroom find par('1.8-v(vo)') at=1\n.meas dc test_output_rail_error param='max(0,max(-test_vol,max(-test_voh_headroom,max(test_vol-1.8,test_voh_headroom-1.8))))'\n.endif\n.if (sim_type==5)\nVDD vdd 0 DC 1.8\nVIN vin 0 0.9\nVIP vip 0 0.9\n.dc VIP 0.8 1 0.2\nVSHORT vo 0 0.9\n.meas dc test_isc_source find i(VSHORT) at=1\n.meas dc test_isc_sink find par('-i(VSHORT)') at=0.8\n.endif\n.alter\n.temp 125\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=1\n.alter\n.temp 125\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=2\n.alter\n.temp 125\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=3\n.alter\n.temp 125\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=4\n.alter\n.temp 125\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=5\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=0\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=1\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=2\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=3\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=4\n.alter\n.temp -40\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" SS\n.param sim_type=5\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=0\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=1\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=2\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=3\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=4\n.alter\n.temp 125\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=5\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=0\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=1\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=2\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=3\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=4\n.alter\n.temp -40\n.del lib 1 SS\n.lib \"./hsp_model/smic18_hsp_model/ms018_v1p7.lib\" FF\n.param sim_type=5\n.end\n",
